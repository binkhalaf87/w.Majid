# Meta WhatsApp Cloud API
TOKEN="replace-with-permanent-access-token"
PHONE_NUMBER_ID="replace-with-phone-number-id"
WABA_ID="replace-with-whatsapp-business-account-id"
VERIFY_TOKEN="whatsapp-majid-verify-change-me"
APP_SECRET="replace-with-meta-app-secret"
GRAPH_API_VERSION="v20.0"

# PostgreSQL (Neon, Supabase, Vercel Postgres, etc.)
DATABASE_URL="postgresql://user:password@host:5432/whatsapp_majid?sslmode=require"

# Personal dashboard protection. Leave ADMIN_USERNAME as majid if desired.
ADMIN_USERNAME="majid"
ADMIN_PASSWORD="replace-with-a-long-random-password"

# Optional UI polling interval (minimum enforced: 3000ms)
NEXT_PUBLIC_POLL_MS="3000"
